// pgdriver.nv — the `std.sql` driver: a `Database` a program can hold
// without naming an engine, over the PostgreSQL wire.
//
// THE SAME CONTRACT sqlite-nv IMPLEMENTS, over a socket instead of a
// file.  A program written against `dyn Database` runs over either,
// with nothing in it naming either:
//
//   fn migrate(db: dyn Database) -> Str [io, fs, net]
//       match db.exec("CREATE TABLE t (n INTEGER)")
//
// THE EFFECT ROW ON THIS IMPL IS `[io, net, time]`, AND THE TRAIT SAYS
// `[io]`.  That is legal — a trait with no effect parameter does not
// pin its impls' rows, and the standard library's own `SqliteDb`
// already declares `[fs]` against the same `[io]` — and it is worth
// writing down what it costs, because the cost is somebody else's.
// `[time]` is there because a connection that will not answer has to
// stop being waited for, and `[io]` because a socket is read and
// written rather than merely opened.
//
// A `dyn Database` call is charged the UNION over every impl in the
// program (SPEC § 5.6).  So a program that links this package makes
// EVERY `dyn Database` call in it cost `[io, net, time]`, including the
// ones that only ever hold a SQLite file.  A concrete `PgDatabase`
// receiver is charged `[io, net, time]` and a concrete `SqDatabase`
// receiver `[fs]`, so the union is only paid where the engine really
// is unknown — which is the right place to pay it and is still more
// than the trait's own declaration suggests.
//
// This is the same obstruction `Connection` records in its own header
// and has the same fix: an effect parameter on the trait
// (`trait Database[e]`, SPEC § 5.6), so that each impl supplies what
// it costs and a `dyn` caller is charged the union of the impls that
// are actually in the program rather than of the ones that could be.
// It is a CONTRACT change and belongs in a feature file; this package
// names it rather than working around it.
//
// THE CONTRACT IS NARROW AND THE ROWS ARE ELSEWHERE.  `Database` has
// no Rows/Row surface, so `close`, `exec` and `query_count` are what
// crosses the engine boundary and `pgquery`'s functions are what
// returns rows.  A caller that wants rows has chosen PostgreSQL by
// then, which is the trade the contract makes on purpose.
//
// `close` IS TWO DIFFERENT ACTIONS AND THE HANDLE KNOWS WHICH.  A
// handle from `open` owns its connection and closes the socket; a
// handle from `of_conn` — a borrowed connection, a pooled one — does
// NOT, and resets the session instead, because a driver that closed a
// pooled connection would empty the pool one request at a time.  The
// `owned` field is the whole of the difference and there is no way to
// tell the two apart from the outside, which is why it is a field and
// not a rule in a comment.
//
// `last_fault` CANNOT BE FILLED HERE.  The contract's own methods
// answer a `DbError`, and a handle is a value: an `Err` carries no
// handle, so there is nowhere to record the fault behind it — see
// `last_fault`.  The full fault is reachable through `query`, which
// answers `Err(pgerror.PgFault)`, and that is where a caller that
// wants the SQLSTATE, the constraint name and the byte position
// should look.

use pgconn
use pgerror
use pgmsg
use pgpool
use pgquery
use pgtype

// A PostgreSQL database, as a `Database`.
//
// Named `PgDatabase` and not `Postgres` or `Database`: struct
// identity is keyed by NAME across a whole assembly (E2004), and a
// package that names a common noun takes it from every consumer.
pub struct PgDatabase
    conn: pgconn.PgConn
    // The fault behind the last `DbError`, which the contract has no
    // room for.  See `last_fault` for why this package cannot put one
    // here.
    last: ?pgerror.PgFault
    // True when this handle owns its connection, which is what decides
    // between closing the socket and resetting the session.  See the
    // module comment.
    owned: Bool

// The prelude `Database` contract, over the PostgreSQL wire.
//
// ```novo
// use pgdriver
// use pgconn
//
// fn main() [io, net, time]
//     match pgdriver.open(pgconn.default_options("postgres"), pgconn.plain_transport())
//         Err(_) => println("no")
//         Ok(db) =>
//             match db.exec("CREATE TABLE t (n INTEGER)")
//                 Some(e) => println("failed")
//                 None    => println("ok")
// ```
impl Database for PgDatabase
    // Send `Terminate` and close the socket, or reset a connection
    // this handle does not own.
    //
    // OWNERSHIP IS THE WHOLE OF THE DIFFERENCE — see the module
    // comment.  A borrowed connection is rolled back rather than
    // closed: `ROLLBACK` outside a transaction is a warning and not an
    // error, so this is safe to call on any session, and a session
    // left inside a transaction would hand the pool's next borrower
    // somebody else's.
    fn close(self) [io, net, time]
        if self.owned
            let _ = pgconn.close(self.conn)
        else
            let _ = pgquery.rollback(self.conn)

    // Run a statement that returns no rows.
    //
    // `None` is success.  The server's SQLSTATE is what decides the
    // `DbError` variant, never the message text — 23xxx is a
    // `ConstraintViolation`, 42xxx a `SyntaxError`, 08xxx and 57xxx a
    // `ConnectionError`, and everything else `DbOther`.  The full
    // field set is not lost: `last_fault` answers it with the
    // constraint name, the column and the byte position the contract
    // has no room for.
    //
    // The simple protocol, because the statement has no parameters and
    // nothing to describe: one round trip rather than four.
    fn exec(self, sql: Str) -> ?DbError [io, net, time]
        match pgquery.simple(self.conn, sql)
            Ok(_)  => None
            Err(f) => Some(to_db_error(f))

    // How many rows `sql` produces.
    //
    // Runs the statement and counts.  There is no plan-time estimate
    // here and `EXPLAIN`'s would be one — inventing it would make a
    // caller think it had asked a cheap question and had got a true
    // answer, and it would be neither.
    //
    // A statement that DESCRIBES columns answers the rows it produced,
    // and one that does not — an `INSERT`, an `UPDATE` — answers the
    // rows it affected, which is the number the tag carried.  The
    // whole result set is fetched to count it, which is the price of
    // an honest answer: see the paragraph above.
    fn query_count(self, sql: Str) -> Result<Int, DbError> [io, net, time]
        let done = match pgquery.query(self.conn, sql, [], pgmsg.PgText)
            Err(f) =>
                return Err(to_db_error(f))
            Ok(v)  => v
        if list.len(done.result.columns) > 0
            return Ok(list.len(done.result.rows))
        Ok(done.result.affected)

// Open a database over a fresh connection.
//
// The handle OWNS the connection, so `close` closes it.
//
// ```novo
// use pgdriver
// use pgconn
//
// fn main() [io, net, time]
//     match pgdriver.open(pgconn.default_options("postgres"), pgconn.plain_transport())
//         Ok(db) => println("connected")
//         Err(_) => println("could not connect")
// ```
pub fn open(o: pgconn.PgConnectOptions,
            t: pgconn.PgTransport) -> Result<PgDatabase, pgerror.PgFault> [io, net, time]
    let c = pgconn.connect(o, t)!
    Ok(PgDatabase { conn: c, last: None, owned: true })

// Wrap a connection the caller already has — one borrowed from a
// pool, for instance.
//
// Does NOT close it on `close`: a pooled connection is the pool's,
// and a driver that closed one would empty the pool a request at a
// time.  `close` on a borrowed database resets the session instead,
// and the caller still has to `pgpool.release`.
pub fn of_conn(c: pgconn.PgConn) -> PgDatabase
    PgDatabase { conn: c, last: None, owned: false }

// Take a connection from a pool and wrap it.
//
// The shape a request handler uses: acquire, work, release.  Answers
// the pool as well, because the pool is a value.
pub struct PgBorrowed
    pool: pgpool.PgPool
    db: PgDatabase

// Borrow.
//
// The handle does not own the connection — see `of_conn` — and the
// pool is answered with it because every pool operation answers a new
// pool.
pub fn borrow(p: pgpool.PgPool, now_ms: Int) -> Result<PgBorrowed, pgerror.PgFault> [io, net, time]
    let held = pgpool.acquire(p, now_ms)!
    Ok(PgBorrowed { pool: held.pool, db: of_conn(held.conn) })

// Give a borrowed database back to its pool.
//
// Closes nothing: a connection that is going back to a pool is the
// pool's to keep, reset or throw away, and `pgpool.release` is the
// one place that decides.
pub fn give_back(p: pgpool.PgPool, db: PgDatabase,
                 now_ms: Int) -> Result<pgpool.PgPool, pgerror.PgFault> [io, net, time]
    pgpool.release(p, db.conn, now_ms)

// The fault behind the last `DbError` this handle answered, or
// `None`.
//
// The prelude's `DbError` has five variants and a message; a
// `pgerror.PgFault` carries the SQLSTATE, the constraint name, the
// column, the byte position and everything else the server sent.  A
// caller written against `dyn Database` gets the first; one that has
// chosen this engine can ask for the second, which is the only place
// "the unique index `users_email_key`" survives the contract.
//
// THIS PACKAGE CANNOT FILL IT IN, AND SAYS SO RATHER THAN ANSWERING
// `None` FOREVER IN SILENCE.  `exec` answers a `?DbError` and
// `query_count` a `Result<Int, DbError>`; neither returns the handle,
// and a handle is a value — so a fault has nowhere to be recorded on
// the one the caller still holds and this field stays `None` for a
// handle from `open` or `of_conn`.  The full fault is not out of
// reach: `query` answers `Err(pgerror.PgFault)` with all of it, and
// that is where a caller that needs the detail should look.
//
// ```novo
// use pgdriver
// use pgconn
//
// fn main() [io, net, time]
//     match pgdriver.open(pgconn.default_options("postgres"), pgconn.plain_transport())
//         Err(_) => println("no")
//         Ok(db) =>
//             match pgdriver.last_fault(db)
//                 Some(f) => println("something went wrong")
//                 None    => println("nothing has yet")
// ```
pub fn last_fault(db: PgDatabase) -> ?pgerror.PgFault
    db.last

// The connection underneath, for the rows the contract cannot carry.
//
// `pgquery.query` takes it.  Published rather than hidden because a
// driver that made the rows unreachable would be one nobody could
// use for a `SELECT`.
pub fn conn_of(db: PgDatabase) -> pgconn.PgConn
    db.conn

// Every row of a query, as the values this package decodes.
//
// The convenience over `pgquery.query` for a caller holding a
// `PgDatabase` rather than a connection.
pub struct PgRows
    db: PgDatabase
    rows: [[pgtype.PgValue]]

// Query.
//
// The failure carries the whole `pgerror.PgFault`, which is what
// `last_fault` cannot: see `last_fault`.
pub fn query(db: PgDatabase, sql: Str,
             parameters: [pgtype.PgValue]) -> Result<PgRows, pgerror.PgFault> [io, net, time]
    let done = pgquery.query(db.conn, sql, parameters, pgmsg.PgText)!
    Ok(PgRows { db: db, rows: done.result.rows })

// The `DbError` a fault maps to, by SQLSTATE.
//
// Published because the mapping is a judgement and a caller may
// disagree with it — an application that treats a deadlock as a
// connection problem rather than as `DbOther`, say — and because a
// mapping nobody can see is one nobody can check.
//
// The classes this decides by:
//
//   * `23` — integrity constraint violations, the one class a
//     `ConstraintViolation` names exactly;
//   * `42` — syntax errors and access-rule violations, `SyntaxError`;
//   * `08`, `53`, `57` and `58` — connection exceptions, insufficient
//     resources, operator intervention and system errors, all of which
//     mean the session rather than the statement, `ConnectionError`;
//   * `DbNotFound` is NOT ANSWERED BY THIS ENGINE: PostgreSQL has no
//     SQLSTATE for "no such row", a `SELECT` that matched nothing is a
//     success with no rows, and inventing the variant would report a
//     working query as a missing one.
//
// ```novo
// use pgdriver
// use pgerror
//
// fn main() [io]
//     match pgdriver.to_db_error(pgerror.PgTimedOut(operation: "query", ms: 1000))
//         ConnectionError(m) => println("a connection problem")
//         e                  => println("something else")
// ```
pub fn to_db_error(f: pgerror.PgFault) -> DbError
    match f
        PgServerError(_)         => by_sqlstate(pgerror.sqlstate(f), pgerror.describe(f))
        PgConnectFailed(_, _, _) => ConnectionError(pgerror.describe(f))
        PgConnectionLost(_)      => ConnectionError(pgerror.describe(f))
        PgTimedOut(_, _)         => ConnectionError(pgerror.describe(f))
        PgPoolExhausted(_, _)    => ConnectionError(pgerror.describe(f))
        _                        => DbOther(pgerror.describe(f))

// The class-to-variant table `to_db_error` decides by, written once so
// that a reader can check it against the server's own list.
fn by_sqlstate(code: Str, message: Str) -> DbError
    let class = pgerror.sqlstate_class(code)
    if class == "23"
        return ConstraintViolation(message)
    if class == "42"
        return SyntaxError(message)
    if class == "08"
        return ConnectionError(message)
    if class == "53"
        return ConnectionError(message)
    if class == "57"
        return ConnectionError(message)
    if class == "58"
        return ConnectionError(message)
    DbOther(message)
