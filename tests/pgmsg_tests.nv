// pgmsg_tests.nv — the framing, and the one rule a pipelining client
// gets wrong.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: postgres-nv.<module>.<fn>`.
// That is the expected result until the bodies land.
//
// THE VECTORS ARE THE PROTOCOL'S OWN CONSTANTS.  196608 is protocol
// 3.0 as the startup packet spells it; 80877103 and 80877102 are the
// SSLRequest and CancelRequest codes; they are in PostgreSQL's own
// `pqcomm.h` and have not changed since 2003.  Asserting them is a
// port check rather than a restatement of this package's code.

use std.test
use std.bytes
use pgerror
use pgmsg

@test
fn test_the_three_startup_codes_are_the_protocol_s_own() [io]
    test.case("protocol version 3.0")
    test.assert(pgmsg.protocol_version() == 196608)

    test.case("the TLS negotiation code")
    test.assert(pgmsg.ssl_request_code() == 80877103)

    test.case("and the cancel code, one below it")
    test.assert(pgmsg.cancel_request_code() == 80877102)
    test.assert(pgmsg.cancel_request_code() == pgmsg.ssl_request_code() - 1)

@test
fn test_a_socket_read_is_not_a_message() [io]
    // A read returns whatever the kernel had, which is a message and a
    // half about as often as it is a message.  A client that assumed
    // otherwise works on localhost and fails under load.
    test.case("an empty buffer holds no whole message")
    match pgmsg.frame_length(bytes.zeros(0), 0, 1048576)
        Err(_) => test.assert(false)
        Ok(n)  => test.assert_none(n)

    test.case("and four bytes of a five-byte header do not either")
    match pgmsg.frame_length(bytes.zeros(4), 0, 1048576)
        Err(_) => test.assert(false)
        Ok(n)  => test.assert_none(n)

    test.case("the type byte is readable before the length is complete")
    test.assert_none(pgmsg.frame_kind(bytes.zeros(0), 0))

@test
fn test_a_length_is_the_caller_s_budget_and_not_the_wire_s() [io]
    // Four bytes an attacker controls.  A DataRow can legitimately be
    // a gigabyte, so the ceiling is the caller's and a length past it
    // is a refusal rather than an allocation.
    test.case("a ceiling of zero refuses anything with a body")
    match pgmsg.frame_length(bytes.zeros(16), 0, 0)
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(true)

    test.case("and bytes that are not a message are refused, not decoded")
    match pgmsg.decode_backend(bytes.zeros(0), 0, 1048576)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_only_ready_for_query_ends_an_exchange() [io]
    // THE ASSERTION THIS FILE EXISTS FOR.  A client that acted on a
    // CommandComplete acted inside a transaction the server may have
    // already aborted; ReadyForQuery is the only message that says
    // everything before it is settled, and it carries the status.
    test.case("ReadyForQuery ends it")
    test.assert(pgmsg.ends_exchange(pgmsg.PgReadyForQuery(status: pgmsg.PgIdle)))

    test.case("CommandComplete does not")
    test.assert(pgmsg.ends_exchange(pgmsg.PgCommandComplete(tag: "SELECT 1")) == false)

    test.case("and neither does an error")
    test.assert(pgmsg.ends_exchange(pgmsg.PgErrorResponse(fields: pgerror.fields_new())) == false)

    test.case("the status travels with it and nowhere else")
    test.assert_some(pgmsg.tx_status(pgmsg.PgReadyForQuery(status: pgmsg.PgInFailedTransaction)))
    test.assert_none(pgmsg.tx_status(pgmsg.PgParseComplete))

@test
fn test_an_error_makes_the_server_discard_until_sync() [io]
    // Send Parse/Bind/Execute for two statements under one Sync, have
    // the first fail, and the second NEVER RUNS — but a client
    // counting CommandCompletes is still waiting, and the connection
    // hangs rather than errors.
    test.case("an ErrorResponse starts the discarding")
    test.assert(pgmsg.discards_until_sync(pgmsg.PgErrorResponse(fields: pgerror.fields_new())))

    test.case("a notice does not — it is not an error")
    test.assert(pgmsg.discards_until_sync(pgmsg.PgNoticeResponse(fields: pgerror.fields_new())) == false)

    test.case("and nothing else does either")
    test.assert(pgmsg.discards_until_sync(pgmsg.PgBindComplete) == false)
    test.assert(pgmsg.discards_until_sync(pgmsg.PgPortalSuspended) == false)

@test
fn test_three_messages_belong_to_no_exchange_at_all() [io]
    // ParameterStatus, NoticeResponse and NotificationResponse arrive
    // whenever the server feels like it, including in the middle of a
    // result set.  A read loop that did not route on this is one whose
    // SELECT occasionally returns a notification where a row should be.
    test.case("a parameter change is asynchronous")
    test.assert(pgmsg.is_asynchronous(pgmsg.PgParameterStatus(name: "DateStyle", value: "ISO, MDY")))

    test.case("so is a notice")
    test.assert(pgmsg.is_asynchronous(pgmsg.PgNoticeResponse(fields: pgerror.fields_new())))

    test.case("and so is a NOTIFY from another session")
    test.assert(pgmsg.is_asynchronous(pgmsg.PgNotification(process_id: 7, channel: "c", payload: "")))

    test.case("a DataRow is not")
    test.assert(pgmsg.is_asynchronous(pgmsg.PgDataRow(values: [], nulls: [])) == false)

@test
fn test_the_command_tag_is_not_uniform_and_insert_is_the_exception() [io]
    // INSERT carries an OID before its count, for historical reasons,
    // and every other command does not.  A caller that split on a
    // space gets the OID.
    test.case("a SELECT tag's number is its row count")
    test.assert(pgmsg.tag_rows("SELECT 12") == 12)
    test.assert(pgmsg.tag_command("SELECT 12") == "SELECT")

    test.case("an INSERT tag has TWO numbers and the second is the count")
    test.assert(pgmsg.tag_rows("INSERT 0 3") == 3)
    test.assert(pgmsg.tag_command("INSERT 0 3") == "INSERT")

    test.case("an UPDATE tag has one")
    test.assert(pgmsg.tag_rows("UPDATE 5") == 5)

    test.case("and a DDL tag has none")
    test.assert(pgmsg.tag_rows("CREATE TABLE") == 0)
    test.assert(pgmsg.tag_command("CREATE TABLE") == "CREATE TABLE")

@test
fn test_a_frontend_message_encodes_to_bytes_and_a_batch_to_one_write() [io]
    test.case("Sync is five bytes: a type and a length")
    match pgmsg.encode_frontend(pgmsg.PgSync)
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(bytes.len(b) == 5)

    test.case("Terminate is the same shape")
    match pgmsg.encode_frontend(pgmsg.PgTerminate)
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(bytes.len(b) == 5)

    test.case("a startup message has NO type byte, so it is shorter by one")
    match pgmsg.encode_frontend(pgmsg.PgSslRequest)
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(bytes.len(b) == 8)

    test.case("and a cancel request is sixteen bytes")
    match pgmsg.encode_frontend(pgmsg.PgCancelRequest(process_id: 1, secret_key: 2))
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(bytes.len(b) == 16)

    test.case("a batch is the concatenation, which is what pipelining is")
    match pgmsg.encode_batch([pgmsg.PgFlush, pgmsg.PgSync])
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(bytes.len(b) == 10)
